# Copy to .env.local for local dev, or add each one in Vercel → Project → Settings → Environment Variables.

# ── Required ─────────────────────────────────────────────────────────────────
# One AI key. Set both to choose per job with AI_PROVIDER / AI_PLANNER_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The repo that holds your blog's markdown, as owner/name, and a token that can push to it.
# Fine-grained token: this repo only, permissions Contents: read & write, Pull requests: read & write.
GITHUB_REPO=your-org/your-website
GITHUB_TOKEN=
# Branch to publish to / open PRs against. Defaults to the repo's default branch.
GITHUB_BRANCH=

# Protects the dashboard (HTTP basic auth; any username).
DASHBOARD_PASSWORD=
# Random string; Vercel Cron sends it to /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Provider choice when both keys are set: anthropic | openai
AI_PROVIDER=
# Use a different provider for cheaper jobs (research, snippet rewrites, interlinking).
AI_PLANNER_PROVIDER=

# Models (defaults: claude-opus-5-5 / gpt-6.1-sol)
ANTHROPIC_MODEL=
ANTHROPIC_PLANNER_MODEL=
OPENAI_MODEL=
OPENAI_PLANNER_MODEL=
# Any OpenAI-compatible endpoint that supports the Responses API (e.g. an Azure OpenAI v1 URL).
OPENAI_BASE_URL=

# Override the per-million-token prices used for the spend estimate and cap.
ANTHROPIC_PRICE_IN=
ANTHROPIC_PRICE_OUT=
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
# Overrides run.maxSpendUsd from your repo's config.
MAX_SPEND_USD=

# Google Search Console + Indexing API (a service account with access to your property).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Only if your property isn't sc-domain:<your domain>, e.g. https://example.com/
GSC_SITE_URL=
# Set to 0 to skip the Google Indexing API ping.
GOOGLE_INDEXING=

# IndexNow (Bing, Yandex, Seznam, Naver). Your site must serve /<key>.txt containing the key.
INDEXNOW_KEY=

# Set to 1 to stop the daily run without removing the cron.
AGENT_PAUSED=
